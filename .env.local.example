# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (M7+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (M14+)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Must be a Price ID (price_...), not a Product ID (prod_...) — Stripe
# Checkout's line_items.price takes a price, not a product.
STRIPE_PRO_PRICE_ID=

# Resend (M13+)
RESEND_API_KEY=
# Optional: "Name <verified@yourdomain.com>". Defaults to Resend's shared
# sandbox address, which only delivers to the account's own verified email.
RESEND_FROM_EMAIL=
